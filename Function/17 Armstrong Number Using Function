#include<stdio.h>
int number(int n) {
    int a = n;
    int sum =0;
    for (; a > 0; a /= 10) {
        int s = a % 10;
        sum =sum+s * s * s;
    }
    if (sum == n) {
        printf("Armstrong Number");
    } else {
        printf("Not Armstrong Number");
    }
}
int main() {
    int n;
    scanf("%d", &n);
    number(n);
    return 0;
}
