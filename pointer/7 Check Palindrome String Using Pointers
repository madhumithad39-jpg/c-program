#include <stdio.h>
int Palindrome(char *n) {
    char *a = n;
    char *b = n;
    while (*b != '\0') {
        b++;
    }
    b--;
    while (a <b) {
        if (*a != *b)
            return 0;
        a++;
        b--;
    }
    return 1;
}
int main() {
    char s[100];
    scanf("%s", s);
    if (Palindrome(s)) {
        printf("YES");
    }
    else {
        printf("NO");
    }
    return 0;
}
