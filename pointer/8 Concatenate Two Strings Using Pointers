#include <stdio.h>
void con(char *a, char *b) {
    while (*a != '\0') {
        a++;
    }
    if (*(a - 1) == '\n') {
        a--;
    }
    while (*b != '\0') {
        if (*b == '\n') break;   // ignore newline of second string
        *a = *b;
        a++;
        b++;
    }
    *a = '\0';
}
int main() {
    char a[100], b[100];
    fgets(a, sizeof(a), stdin);
    fgets(b, sizeof(b), stdin);
    con(a, b);
    printf("%s", a);
    return 0;
}
