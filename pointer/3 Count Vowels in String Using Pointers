#include <stdio.h>
int countVowels(char *p) {
    int count = 0;
    while (*p != '\0') {
        if (*p=='a'||*p=='e'||*p=='i'||*p=='o'||*p=='u'||
            *p=='A'||*p=='E'||*p=='I'||*p=='O'||*p=='U') {
            count++;
            }
        p++;
    }
    return count;
}
int main() {
    char s[100];
    fgets(s, sizeof(s), stdin);
    printf("%d", countVowels(s));
    return 0;
}
