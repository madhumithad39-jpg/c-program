#include <stdio.h>
void reverse(int *a, int *b) {
    while (a < b) {
        int s = *a;
        *a= *b;
        *b = s;
        a++;
        b--;
    }
}
int main() {
    int n;
    scanf("%d", &n);
    int arr[n];
    int *ptr = arr;
    for (int i = 0; i < n; i++) {
        scanf("%d", ptr);
        ptr++;
    }
    reverse(arr, arr + n - 1);
    ptr = arr;
    for (int i = 0; i < n; i++) {
        printf("%d ", *ptr);
        ptr++;
    }
    return 0;
}
